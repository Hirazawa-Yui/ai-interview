# ============================================================
# 本地环境变量示例 —— 复制为 .env 并填入真实值
# .env 已被 .gitignore 排除，永不提交；真实密钥只存在你本机
# 用法：IDEA Run Configuration → EnvFile 插件 → 勾选本文件
# （或直接以系统/终端环境变量形式注入同名变量）
# ============================================================

# 通义千问/百炼（DashScope）API Key
DASHSCOPE_API_KEY=sk-请填写

# 阿里云 OSS AccessKey（RAM 用户）
OSS_ACCESS_KEY=请填写
OSS_SECRET_KEY=请填写

# PostgreSQL（本地 Docker，无需修改则用默认值）
PG_USERNAME=postgres
PG_PASSWORD=123456

# Redis（本地 Docker，无需修改则用默认值）
REDIS_PASSWORD=123456
